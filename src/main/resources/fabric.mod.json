{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "sources": "${source_url}",
    "issues": "${issue_url}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.mesomods.lootwand.client.LootWandModClient"
    ],
    "main": [
      "net.mesomods.lootwand.LootWandMod"
    ]
  },
  "mixins": [
    "loot_table_wand.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
